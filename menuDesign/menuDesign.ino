const int NUM_ITEMS_LIGHTS = 5; // number of items in the list
const int NUM_ITEMS_SCENES = 3;
const int MAX_ITEM_LENGTH = 20; // maximum characters for the item name
int menu_selections [2] = {
  NUM_ITEMS_LIGHTS,
  NUM_ITEMS_SCENES
};


char menu_items [2] [NUM_ITEMS_LIGHTS] [MAX_ITEM_LENGTH] = {{  // array with the light items and scene items in 3D array
  { "My PC" }, 
  { "Lamp" }, 
  { "Desk Lamp" }, 
